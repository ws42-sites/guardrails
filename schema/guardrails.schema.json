{
  "$ref": "#/definitions/GuardrailsConfig",
  "definitions": {
    "GuardrailsConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "baseBranch": {
          "type": "string",
          "default": "main"
        },
        "sourceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "src"
          ]
        },
        "tiers": {
          "type": "object",
          "properties": {
            "T1": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "T2": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "T3": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "specs": {
          "type": "object",
          "properties": {
            "idPattern": {
              "type": "string",
              "default": "^[A-Z][A-Z0-9]{1,11}-[0-9]{2,4}$"
            },
            "maxTestsPerId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 8
            },
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "tier": {
                    "type": "string",
                    "enum": [
                      "T1",
                      "T2",
                      "T3"
                    ]
                  },
                  "behaviour": {
                    "type": "string",
                    "minLength": 3
                  },
                  "regressionGuard": {
                    "type": "boolean"
                  },
                  "properties": {
                    "type": "boolean"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "journeys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "tier",
                  "behaviour"
                ],
                "additionalProperties": false
              },
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "architecture": {
          "type": "object",
          "properties": {
            "tsConfig": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "forbidden": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "from": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "to": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Importers exempt from this rule"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "singletons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "cliEntries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "**/cli.{ts,js,mjs,cjs}",
                "bin/**",
                "scripts/**"
              ]
            },
            "testEnvAllow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "restrictedStrings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pattern": {
                    "type": "string"
                  },
                  "allowIn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": []
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "pattern",
                  "message"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "deps": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "registry": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "minAgeDays": {
                  "type": "number",
                  "minimum": 0,
                  "default": 30
                },
                "minWeeklyDownloads": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1000
                },
                "cacheHours": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 24
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "duplication": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "minLines": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 5
            },
            "minTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 50
            },
            "maxPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 3
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "scope": {
          "type": "object",
          "properties": {
            "maxProductLines": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 600
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "holdout": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "target": {
              "type": "string",
              "default": "test/holdout"
            }
          },
          "additionalProperties": false
        },
        "lock": {
          "type": "object",
          "properties": {
            "specTests": {
              "type": "boolean",
              "default": true
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "guardrails.config.json",
                ".guardrails/**",
                ".github/CODEOWNERS",
                ".github/workflows/**",
                ".claude/settings.json",
                ".gemini/settings.json",
                ".agents/hooks.json"
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "journeys": {
          "type": "object",
          "properties": {
            "idPattern": {
              "type": "string",
              "default": "^CUJ-[A-Z0-9]{2,16}$"
            },
            "e2eGlobs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "e2e/**/*.spec.ts",
                "e2e/**/*.test.ts"
              ]
            },
            "resultsFile": {
              "type": "string"
            },
            "routeGlobs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "src/pages/**",
                "app/**/page.{ts,tsx,js,jsx}",
                "pages/**",
                "functions/**"
              ]
            },
            "draft": {
              "type": "object",
              "properties": {
                "geminiModel": {
                  "type": "string",
                  "default": "gemini-2.5-flash"
                },
                "openaiModel": {
                  "type": "string",
                  "default": "gpt-4.1-mini"
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20,
                  "default": 8
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "visual": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "mocksDir": {
                  "type": "string",
                  "default": "design/mocks"
                },
                "maxDiffRatio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.01
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 10
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "P0",
                      "P1",
                      "P2"
                    ]
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    },
                    "minItems": 1
                  },
                  "specs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "routes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "approved": {
                    "type": "boolean",
                    "default": false
                  },
                  "approvedBy": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "priority",
                  "steps"
                ],
                "additionalProperties": false
              },
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "fixtures": {
          "type": "object",
          "properties": {
            "globs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "**/fixtures/**",
                "**/__fixtures__/**"
              ]
            },
            "publicDir": {
              "type": "string",
              "default": "public"
            },
            "devOnly": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "tests": {
          "type": "object",
          "properties": {
            "globs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.spec.ts",
                "**/*.spec.tsx"
              ]
            },
            "helperGlobs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "**/test/**",
                "**/__tests__/helpers/**"
              ]
            },
            "budget": {
              "type": "object",
              "properties": {
                "T1": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 1
                },
                "T2": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 0.6
                },
                "T3": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 0.4
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "maxFileLines": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 300
            },
            "command": {
              "type": "string",
              "default": "npx vitest run --pool=forks"
            },
            "clockShiftYears": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 2
            },
            "testsRemovedLabel": {
              "type": "string",
              "default": "tests-removed-approved"
            },
            "propertyTimeLimitMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 5000
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "mutation": {
          "type": "object",
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "T1",
                  "T2",
                  "T3"
                ]
              },
              "default": [
                "T1"
              ]
            },
            "break": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 70
            },
            "timeoutMinutes": {
              "type": "number",
              "exclusiveMinimum": 0,
              "default": 15
            },
            "excludedMutations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "docs": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "AGENTS.md",
                "CLAUDE.md",
                "GEMINI.md",
                "README.md",
                "ARCHITECTURE.md",
                "TESTING.md",
                "RUNBOOK.md"
              ]
            },
            "runtime": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                ".md",
                ".mdx",
                ".txt",
                ".rst"
              ]
            },
            "disguise": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "**/NOTES*",
                "**/TODO*",
                "**/*-plan.*",
                "**/*_plan.*"
              ]
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "public/**",
                "node_modules/**",
                "dist/**",
                "**/LICENSE*",
                "**/CHANGELOG.md"
              ]
            },
            "maxLines": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "default": {
                "default": 250,
                "AGENTS.md": 150
              }
            },
            "agentFile": {
              "type": "string",
              "default": "AGENTS.md"
            },
            "pointerFiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "GEMINI.md",
                "CLAUDE.md",
                ".cursorrules",
                ".windsurfrules",
                ".github/copilot-instructions.md"
              ]
            },
            "requiredLinks": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "runbook": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "file": {
              "type": "string",
              "default": "RUNBOOK.md"
            },
            "maxLines": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 150
            },
            "packageJson": {
              "type": "string",
              "default": "package.json"
            },
            "na": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 10
              },
              "propertyNames": {
                "enum": [
                  "deploy",
                  "deploy:preview",
                  "rollback",
                  "smoke",
                  "secrets:check"
                ]
              },
              "default": {}
            },
            "workflows": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                ".github/workflows/*.yml",
                ".github/workflows/*.yaml"
              ]
            },
            "allowDocs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "ci": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "workflows": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                ".github/workflows/*.yml",
                ".github/workflows/*.yaml"
              ]
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "globalFiles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "package.json",
                "package-lock.json",
                "**/tsconfig*.json",
                "vitest.config.*",
                "vitest.setup.*",
                "playwright.config.*",
                ".nvmrc"
              ]
            },
            "na": {
              "type": "object",
              "properties": {
                "nightly": {
                  "type": "string",
                  "minLength": 10
                },
                "preDeploy": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "off"
            ]
          },
          "default": {}
        },
        "baselineFile": {
          "type": "string",
          "default": ".guardrails/baseline.json"
        },
        "flagsFile": {
          "type": "string",
          "default": ".guardrails/flags.json"
        },
        "labels": {
          "type": "object",
          "properties": {
            "rebaseline": {
              "type": "string",
              "default": "guardrails:rebaseline"
            },
            "characterization": {
              "type": "string",
              "default": "allow-characterization"
            },
            "flagsResolved": {
              "type": "string",
              "default": "flags-resolved"
            },
            "configApproved": {
              "type": "string",
              "default": "guardrails:config-approved"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
