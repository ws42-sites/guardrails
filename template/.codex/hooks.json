{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install guardrails hook-guard --agent codex",
            "timeout": 10,
            "statusMessage": "Checking guardrails locks"
          }
        ]
      }
    ]
  }
}
