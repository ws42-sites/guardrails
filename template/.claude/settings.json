{
  "env": {
    "GUARDRAILS_AGENT": "claude-code"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install guardrails hook-guard --agent claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
