  {
   "id": "delete-snapshot-removes-legacy-rows-too",
   "description": "delete_snapshot clears legacy nodes and edges as well as the snapshot.",
   "steps": [
    {
     "op": "raw",
     "script": "\nCREATE TABLE snapshots(id INTEGER PRIMARY KEY,repo TEXT NOT NULL,revision TEXT NOT NULL,indexed_at TEXT DEFAULT CURRENT_TIMESTAMP);\nCREATE TABLE nodes(id TEXT PRIMARY KEY,snapshot_id INTEGER NOT NULL,kind TEXT NOT NULL,name TEXT NOT NULL,path TEXT NOT NULL,line INTEGER,metadata TEXT DEFAULT '{}');\nCREATE TABLE edges(snapshot_id INTEGER NOT NULL,source TEXT NOT NULL,target TEXT NOT NULL,kind TEXT NOT NULL,evidence TEXT,PRIMARY KEY(snapshot_id,source,target,kind));\nINSERT INTO snapshots(id,repo,revision,indexed_at) VALUES(1,'owner/repo','legacy','2025-12-31 00:00:00');\nINSERT INTO nodes VALUES('root',1,'repository','owner/repo','.',NULL,'{}');\nINSERT INTO nodes VALUES('file',1,'file','module.py','module.py',NULL,'{}');\nINSERT INTO nodes VALUES('function',1,'function_definition','legacy_function','module.py',1,'{}');\nINSERT INTO edges VALUES(1,'root','file','CONTAINS','module.py');\nINSERT INTO edges VALUES(1,'file','function','DEFINES','module.py:1');\n"
    },
    {
     "op": "connect"
    },
    {
     "op": "sql",
     "statements": [
      "INSERT INTO analyses VALUES('an-alpha','8ed3f6ad685b959ead7022518e1af76cd816f8e8ec7ccdda1ed4018e8f2223f8','1111111111111111111111111111111111111111','python','analyser-1',120,'[[\"function_definition\",\"alpha\",1,null],[\"class_definition\",\"Beta\",5,null],[\"function_definition\",\"run\",6,\"Beta\"]]','{\"imports\":[],\"calls\":[]}')",
      "INSERT INTO snapshots(id,repo,revision,indexed_at,metadata,node_prefix,view_key) VALUES(2,'owner/repo','rev-2','2026-01-02 00:00:00','{}','p2','branch')",
      "INSERT INTO snapshot_files VALUES(2,'src/a.py','f1','a.py','an-alpha')"
     ]
    },
    {
     "op": "call",
     "fn": "delete_snapshot",
     "args": [
      1
     ],
     "state": true
    },
    {
     "op": "call",
     "fn": "delete_snapshot",
     "args": [
      12345
     ]
    },
    {
     "op": "call",
     "fn": "delete_snapshot",
     "args": [
      2
     ],
     "state": true
    },
    {
     "op": "read",
     "fn": "query",
     "args": [
      "SELECT id,snapshot_id,kind,name,path,line,metadata FROM nodes ORDER BY id"
     ]
    }
   ]
  },
