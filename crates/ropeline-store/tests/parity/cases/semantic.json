  {
   "id": "corrupt-vectors-fail-closed-and-are-not-served",
   "description": "A stored vector that fails validation is an error, never a hit, and never touches recency.",
   "steps": [
    {
     "op": "open"
    },
    {
     "op": "put",
     "key": "good",
     "vector": {
      "axis": 0
     },
     "characters": 5
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('short','[0]',5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('not-json','not json',5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('zeros',(SELECT '['||group_concat(0,',')||']' FROM (WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<768) SELECT x FROM c)),5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('strings',(SELECT '['||group_concat('\"a\"',',')||']' FROM (WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<768) SELECT x FROM c)),5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('booleans',(SELECT '['||group_concat('true',',')||']' FROM (WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<768) SELECT x FROM c)),5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('nans',(SELECT '['||group_concat('NaN',',')||']' FROM (WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<768) SELECT x FROM c)),5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('long',(SELECT '['||group_concat('0.036',',')||']' FROM (WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM c WHERE x<769) SELECT x FROM c)),5,1);"
    },
    {
     "op": "raw",
     "script": "INSERT INTO semantic_vectors VALUES('object','{}',5,1);"
