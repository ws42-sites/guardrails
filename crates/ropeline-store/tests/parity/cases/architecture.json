  {
   "id": "retention-never-evicts-another-repository",
   "description": "Only the newest 100 reports of a repository are kept; a neighbour's report survives.",
   "steps": [
    {
     "op": "put",
     "report": {
      "repository": "neighbour/repo",
      "revision": "only",
      "base_revision": null,
      "policy_digest": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "engine_version": "architecture-1.1.0"
     },
     "key": "n"
    },
    {
     "op": "putMany",
     "count": 101,
     "repository": "owner/repo"
    },
    {
     "op": "get",
     "repository": "owner/repo",
     "revision": "rev-0",
     "base": null,
     "policy": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "key": "k-0"
    },
    {
     "op": "get",
     "repository": "owner/repo",
     "revision": "rev-1",
     "base": null,
     "policy": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "key": "k-1"
    },
    {
     "op": "get",
     "repository": "owner/repo",
     "revision": "rev-100",
     "base": null,
     "policy": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "key": "k-100"
    },
    {
     "op": "get",
     "repository": "neighbour/repo",
     "revision": "only",
     "base": null,
     "policy": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "key": "n"
    },
    {
     "op": "query",
     "sql": "SELECT repository,count(*),min(rowid),max(rowid) FROM architecture_reports GROUP BY repository ORDER BY repository"
    }
   ],
   "noState": true
  },
  {
   "id": "replacing-a-report-keeps-it-newest",
