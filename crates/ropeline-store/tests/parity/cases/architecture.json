 "cases": [
  {
   "id": "report-round-trip-and-key-order",
   "description": "A report is stored with sorted keys and Python's float and escape forms, and comes back equal.",
   "steps": [
    {
     "op": "put",
     "report": {
      "repository": "owner/repo",
      "revision": "rev-1",
      "base_revision": null,
      "policy_digest": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "engine_version": "architecture-1.1.0",
      "z": 1,
      "nested": {
       "b": [
        1,
        2.5,
        {
         "y": 1e-07,
         "x": "caf\u00e9 \u2028 \ud83d\ude00"
        },
        1e+22,
        123456789.125,
        -0.0
       ],
       "a": null,
       "t": true,
       "quote": "say \"hi\"\n\ttab\\"
      },
      "big": 12345678901234567890,
      "small": -9007199254740993,
      "zero": 0,
      "empty_list": [],
      "empty_object": {}
     },
     "key": "key-1",
     "state": true
    },
    {
     "op": "get",
     "repository": "owner/repo",
     "revision": "rev-1",
     "base": null,
     "policy": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "key": "key-1"
    },
    {
     "op": "get",
     "repository": "owner/repo",
     "revision": "rev-1",
     "base": null,
     "policy": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
     "key": "other-key"
    }
   ]
  },
